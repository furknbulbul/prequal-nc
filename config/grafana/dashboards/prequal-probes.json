{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "uid": "prequal-probes",
  "title": "PreQual Probe Diagnostics",
  "tags": ["prequal", "loadbalancer", "diagnostics"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Probe throughput (per sec)",
      "description": "Rate of probes triggered vs successfully returned. Big gap = probes failing.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (algorithm) (rate(prequal_probes_triggered_total[30s]))",
          "legendFormat": "triggered ({{algorithm}})"
        },
        {
          "refId": "B",
          "expr": "sum by (algorithm) (rate(prequal_probes_succeeded_total[30s]))",
          "legendFormat": "succeeded ({{algorithm}})"
        },
        {
          "refId": "C",
          "expr": "sum by (algorithm) (rate(prequal_probes_failed_total[30s]))",
          "legendFormat": "failed total ({{algorithm}})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Probe failures by reason (per sec)",
      "description": "reason=timeout means /health didn't answer within ProbeTimeout. transport=connection/IO error. http_status=non-2xx.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(prequal_probes_failed_total[30s]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Probe duration quantiles (LB-measured wall time)",
      "description": "End-to-end /health roundtrip from the LB's view. p99 climbing toward ProbeTimeout (200ms) = backend probe path is saturating.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(prequal_probe_duration_seconds_bucket[30s])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(prequal_probe_duration_seconds_bucket[30s])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(prequal_probe_duration_seconds_bucket[30s])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Probes in-flight & pool size",
      "description": "Probes in-flight near LB goroutine cap = LB-side stall. Pool size dropping below PoolCap = probes can't refill pool fast enough.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "prequal_probes_inflight",
          "legendFormat": "in-flight ({{algorithm}})"
        },
        {
          "refId": "B",
          "expr": "prequal_pool_size",
          "legendFormat": "pool size ({{algorithm}})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pick class distribution (per sec)",
      "description": "cold = healthy PreQual pick. hot = picked from above-threshold subset (latency unknown). no-pool / no-winner = fallback to random because pool was empty or HCL had no candidate.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (rate(prequal_pick_class_total[30s]))",
          "legendFormat": "{{class}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Fallback rate (no-pool + no-winner / total picks)",
      "description": "Fraction of picks that fell back to random selection. >0 means PreQual is degrading toward RR with noise.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prequal_pick_class_total{class=~\"no-pool|no-winner\"}[1m])) / clamp_min(sum(rate(prequal_pick_class_total[1m])), 1)",
          "legendFormat": "fallback %"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Probe failure rate (failed / triggered)",
      "description": "Fraction of probes that did not return a usable result. Spikes here = the network/backend probe path is the limit.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prequal_probes_failed_total[1m])) / clamp_min(sum(rate(prequal_probes_triggered_total[1m])), 1)",
          "legendFormat": "failure %"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request throughput by algorithm (per sec)",
      "description": "Sanity check vs hey's reported rps. If PreQual line plateaus below RR while probe failure stays low, the bottleneck is the LB itself (lock contention), not network.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (algorithm) (rate(request_duration_seconds_count[30s]))",
          "legendFormat": "{{algorithm}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Request latency p50/p99 by algorithm",
      "description": "PreQual should be lower than RR. Currently inverted (PreQual higher) — confirm here before/after each fix.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, algorithm) (rate(request_duration_seconds_bucket[30s])))",
          "legendFormat": "p50 {{algorithm}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, algorithm) (rate(request_duration_seconds_bucket[30s])))",
          "legendFormat": "p99 {{algorithm}}"
        }
      ]
    }
  ]
}
